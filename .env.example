# CropDiseaseAI Environment Variables
# Groq LPU API Key for fast LLM agricultural reasoning & translation
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Pinecone Serverless Vector Database for certified ICAR/ANGRAU RAG
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=cropdisease-rag
PINECONE_NAMESPACE=agricultural-rag
