[Unit]
Description=CropDiseaseAI FastAPI Microservice
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/CropDiseaseAI
Environment="PATH=/home/ubuntu/CropDiseaseAI/venv/bin"
ExecStart=/home/ubuntu/CropDiseaseAI/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
